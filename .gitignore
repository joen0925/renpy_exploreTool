# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# 測試產生的檔案
/test_trace.txt
/tests/screenshots/

# Claude Code 的工作設定與初始化模板 (不納入版控)
/.claude/
/claude_init/

# 待實作項目清單 (開發過程的備忘，不納入版控)
/pending_imp.md
