##################################################
# me.rpy —— 主角
#
#   關於主角的一切都在這一個檔案裡，跟「一個檔案一個房間」同一個原則。
##################################################

# 主角說話時對話框上顯示的名字。
#
# 大部分台詞還是旁白（這是第一人稱的探索遊戲，玩家看到的就是自己的視角），
# 需要「明確是主角在開口」時才用這個，例如跟 NPC 對話。
define me = Character("你")


# 立繪只有一個背影。
#
# 第一人稱視角，玩家平常看不到自己 —— 只有「鬼走到主角面前」那種
# 需要看到兩個人相對位置的演出才會用到。
#
# 不想要主角出現在畫面上（純第一人稱、鬼直接朝鏡頭走來）的話，
# 把演出裡那兩行 show me back / hide me 刪掉就好，其他不用動。
image me back = Text("🧍", size=300, color="#e8eaed")


init python:

    def build_me():
        return Actor(
            key="player",          # 引擎認得這個 id (PLAYER_ACTOR)，不要改
            name="你",

            # hp 是引擎唯一認得的數值名稱：歸零就是死亡。
            stats={"hp": 5},

            # 狀態欄 (左上角) 要顯示哪些數值，由上往下依這個順序排。
            #
            # 只有列在這裡的才會顯示 —— 所以不會把不該給玩家看的
            # 內部計數器漏出去。列在這裡但「沒被設定過」的也會自動跳過，
            # 例如還沒拿到手電筒時就不會出現一列「🔦 0」。
            status_display=[
                {"stat": "hp", "icon": "❤️"},
                {"stat": "battery", "icon": "🔦"},
            ],
        )
